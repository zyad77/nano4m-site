  "models": [
    {
      "id": "baseline",
      "name": "Baseline",
      "codename": "random / model_v0",
      "textMask": "random",
      "imageMask": "random",
      "description": "The original nano4M: selects target positions uniformly at random across all modalities. Simple and general, but ignores modality structure.",
