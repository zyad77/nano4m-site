      "image": "assets/masking_random.png"
    },
    {
      "id": "v1",
      "name": "V1",
      "codename": "model_v1 / span",
      "textMask": "span",
      "imageMask": "random",
      "description": "Contiguous span masking on scene_desc text (geometric distribution, p=0.2, mean span ~5 tokens) with sentinel tokens. Random masking on image modalities.",
      "accent": "#2563eb",
      "image": "assets/masking_span.png"
    },
    {
      "id": "v2",
      "name": "V2",
      "codename": "model_v2",
      "textMask": "random",
      "imageMask": "block",
      "description": "Random masking on text. Rectangular block masking on the 16x16 image-token grid for RGB, depth, and normal modalities.",
      "accent": "#16a34a",
      "image": "assets/masking_block.png"
    },
    {
      "id": "v3",
      "name": "V3",
      "codename": "model_v3 / structured",
      "textMask": "span",
      "imageMask": "block",
      "description": "Fully structured: span masking on text + block masking on images. The most constrained reconstruction objective.",
      "accent": "#ea580c",
      "image": "assets/masking_block.png"
    },
    {
      "id": "v4",
      "name": "V4",
      "codename": "model_v4",
      "textMask": "50% span / 50% random",
      "imageMask": "50% block / 50% random",
      "description": "Mixed strategy: each modality independently applies structured or random masking with 50% probability. Balances diversity and structure.",
      "accent": "#7c3aed",
      "image": "assets/masking_mixed.png"
    }
  ],
